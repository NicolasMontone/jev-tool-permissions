{
  "name": "jev-tool-permissions",
  "version": "0.1.0",
  "description": "Agent tool-permission gating and tool-list pruning for the Vercel AI SDK, backed by the typesafe-ai/jev evaluation model.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test"
  },
  "keywords": [
    "ai-sdk",
    "vercel-ai-sdk",
    "jev",
    "agent",
    "tool-permissions",
    "approval",
    "guardrails",
    "mcp"
  ],
  "license": "MIT",
  "peerDependencies": {
    "ai": "^7.0.105"
  },
  "devDependencies": {
    "ai": "^7.0.105",
    "typescript": "^5.7.3",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.5"
  }
}
